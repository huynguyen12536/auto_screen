{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Create venv",
      "type": "shell",
      "command": "python -m venv .venv",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "powershell.exe"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Install requirements",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\Activate.ps1; python -m pip install --upgrade pip; pip install -r requirements.txt",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "powershell.exe"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Run app",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\Activate.ps1; python main.py",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "powershell.exe"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\Activate.ps1; python -m pytest",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "powershell.exe"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Format code",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\Activate.ps1; python -m black .",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "powershell.exe"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Lint code",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\Activate.ps1; python -m flake8 main.py config automation feature vision services utils tests",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "powershell.exe"
        }
      },
      "problemMatcher": []
    }
  ]
}
